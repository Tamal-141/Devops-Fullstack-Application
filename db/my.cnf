# Mounted read-only at /etc/mysql/conf.d/shoplite.cnf. MySQL's defaults assume it owns
# a whole server; here it shares a 2 GB box and gets 700 MB (mem_limit in compose).
#
# mysqld silently IGNORES a world-writable config file. A normal git checkout gives
# 644, which is fine; never `chmod 777` this file.

[mysqld]
# InnoDB's cache for table and index pages — MySQL's single biggest allocation.
innodb_buffer_pool_size = 128M

# Instrumentation tables. On by default and costs a few hundred MB of RAM on its own.
performance_schema = OFF

# Default is 151. One backend pool uses at most 10.
max_connections = 50

# X Protocol plugin (port 33060). Nothing here speaks it.
mysqlx = OFF

# Don't reverse-DNS every client IP on connect — container IPs have no PTR records,
# so each lookup would just wait for a timeout.
skip_name_resolve = ON

# Smaller per-connection / in-memory temp buffers; plenty for this data size.
innodb_log_buffer_size = 8M
tmp_table_size = 16M
max_heap_table_size = 16M
