# Copy to .env and fill in every empty value:   cp .env.example .env
# .env is gitignored — real values never get committed.
# Generate each secret with:                     openssl rand -hex 16
#
# MYSQL_* only take effect when the mysql-data volume is created for the FIRST time.
# Changing them later does not change the passwords inside the database, and the
# backend then fails with 1045 (access denied).

MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=shoplite
MYSQL_USER=shoplite

# At least 32 characters:                        openssl rand -hex 32
JWT_SECRET=

# The one login user (there is no signup). Letters/digits only in the password —
# the smoke test puts it into a JSON string.
SEED_USER_EMAIL=demo@shoplite.local
SEED_USER_PASSWORD=

LOG_LEVEL=info
